# ---- Server ----
PORT=3000
# The public https address Twilio and Square will call. Must match exactly (used to check webhook signatures).
PUBLIC_BASE_URL=https://order.example.ca
# Set by docker-compose. Leave empty for in-memory dev mode (data lost on restart).
DATABASE_URL=postgres://tto:change-me@db:5432/tto
POSTGRES_PASSWORD=change-me

# ---- Business ----
BUSINESS_NAME=Penalty Box Canteen
# Manitoba / northwestern Ontario are permanently UTC-5 since Nov 2026. Etc/GMT+5 works on any tzdata;
# switch to America/Winnipeg once your Node and Postgres images ship tzdata 2026e or later.
TIMEZONE=Etc/GMT+5
# Leave empty to use the Square location's business hours (none set in Square = closed).
# Set it only to override Square, e.g. mon=17:00-22:30,sat=11:00-23:00. Days not listed are closed.
ORDERING_HOURS=
PICKUP_INSTRUCTIONS=Pick up at the canteen window. Show your order number.
# Paid "right away" text orders waiting to be made before new ones are turned away.
# Also the cap per 15 minutes for orders placed for a clock time.
MAX_ACTIVE_ORDERS=15
# Show a tip prompt on the Square checkout page (Square defaults to suggesting one)
ALLOW_TIPPING=false
# Unpaid payment links are cancelled after this many minutes
CART_EXPIRY_MINUTES=20
# Your cell. Gets "needs a person" alerts; can text PAUSE / RESUME / STATUS / TO 1234 msg / BOT 1234
OWNER_PHONE=+18075550100

# ---- Square (developer.squareup.com → your app) ----
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_VERSION=2026-09-16

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18075550147
TWILIO_VALIDATE_SIGNATURE=true

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Admin API (long random string) ----
ADMIN_TOKEN=

# ---- One-word pay (Square card on file) ----
# Largest order a "Y" can pay; bigger orders get a link. Cents.
ONE_TAP_MAX_CENTS=6000
# Most one phone can pay by "Y" in 24 hours. Cents.
ONE_TAP_DAILY_MAX_CENTS=15000

# ---- Game night (HockeyTech feed behind sijhlhockey.com) ----
# All three needed, or game timing stays off. Key and client code are in the lscluster.hockeytech.com requests
# on sijhlhockey.com/stats/schedule (browser dev tools → Network). Lakers team id is 9. Ask the league first.
HOCKEYTECH_KEY=
HOCKEYTECH_CLIENT_CODE=sijhl
HOCKEYTECH_TEAM_ID=9
# Real seconds per minute of game clock (stoppages) and intermission length, for estimating breaks.
GAME_SECONDS_PER_CLOCK_MINUTE=105
GAME_INTERMISSION_MINUTES=18
# Scheduled orders reach the kitchen screen this many minutes before pickup.
PREP_MINUTES=8
# Most orders per intermission (and "after the game").
INTERMISSION_CAPACITY=40
