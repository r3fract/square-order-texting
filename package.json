{
  "name": "text-to-order",
  "version": "0.1.0",
  "private": true,
  "description": "Customers text an order in plain language; an AI builds it against your Square catalog and texts back a Square checkout link (Apple Pay, Google Pay, card).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chat": "tsx scripts/chat.ts",
    "menu": "tsx scripts/menu.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
